{
  "app-id": "io.github.cleomenezesjr.Escambo",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "command": "escambo",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=wayland"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.la",
    "*.a"
  ],
  "modules": [
    "python3-requests.json",
    {
      "name": "escambo",
      "builddir": true,
      "buildsystem": "meson",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/CleoMenezesJr/escambo.git",
          "tag": "0.1.2",
          "commit": "434e58f519fb004a3054545ee133aa8a9f091ef6"
        }
      ]
    }
  ]
}
